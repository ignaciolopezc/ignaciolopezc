---
import { CASES } from '@data/site';
---

<div class="bg-surface">
  <section id="casos" class="wrap section">
    <div class="flex flex-wrap items-end justify-between gap-x-18 gap-y-6">
      <div>
        <p class="eyebrow">03 — Casos</p>
        <h2 class="h2">Problemas reales,<br />procesos que <span class="serif">funcionan</span>.</h2>
      </div>
      <p class="m-0 max-w-[340px] text-[15px] text-muted">
        Un caso por cada plataforma de automatización, siempre con el proceso y la integración como punto de partida.
      </p>
    </div>
    <div class="mt-12 grid grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))] gap-4">
      {CASES.map((item) => (
        <article class="card flex flex-col gap-4 rounded-[18px] border border-line bg-soft p-5">
          <div class="flex justify-between gap-3 font-mono text-xs">
            <span class="text-[#3a3e44]">{item.platform}</span>
            <span class="text-right text-subtle">{item.client}</span>
          </div>
          <div class="flex h-32 items-end gap-2.5 rounded-xl bg-accent-deep p-4 text-white">
            <span class="text-[44px] leading-none font-semibold">{item.figure}</span>
            <span class="pb-1 text-sm text-mint-soft">{item.figureLabel}</span>
          </div>
          <h3 class="px-2 text-[19px]">{item.title}</h3>
          <p class="m-0 px-2 pb-2 text-[15px] text-muted">{item.text}</p>
        </article>
      ))}
    </div>
  </section>
</div>
