---
import { READY_FLOW } from '@data/site';

interface Props {
  years: number;
}

const { years } = Astro.props;
---

<div class="bg-surface">
  <section id="listo" aria-labelledby="listo-titulo" class="wrap section flex flex-wrap items-center gap-x-18 gap-y-14">
    <div class="min-w-0 flex-[1_1_400px]">
      <p class="eyebrow">08 — Siguiente paso</p>
      <h2 id="listo-titulo" class="h2">Todo está listo para empezar. Solo falta<br /><span class="serif whitespace-nowrap">tu contacto</span>.</h2>
      <p class="mt-5 mb-8 max-w-[480px] text-text">
        La experiencia, el método y las herramientas ya están preparados. El primer paso para mejorar tus procesos es una conversación.
      </p>
      <a href="#contacto" class="btn btn-primary" data-umami-event="contacto-siguiente-paso">Conversemos sobre tu proceso</a>
    </div>

    <div class="min-w-0 flex-[1.4_1_560px]">
      <div
        class="mx-auto w-full max-w-[640px] rounded-[18px] bg-ink p-5 font-mono text-[13px] text-[#e6e8ea] shadow-[0_20px_50px_rgb(21_23_26/0.18)] sm:p-6.5"
        role="img"
        aria-label="Flujo de preparación: experiencia, procesos, integración y estándares listos; solo falta tu contacto"
      >
        <div class="mb-3.5 flex flex-wrap justify-between gap-x-3 text-dark-text">
          <span>mejora_de_tu_proceso.flow</span><span class="text-amber">● esperando tu contacto</span>
        </div>
        <div class="flex flex-col gap-2">
          {READY_FLOW.map((row, i) => (
            <div class="frow rounded-lg border border-dark-line px-3.5 py-2.5">
              <span class="text-mint">{String(i + 1).padStart(2, '0')}</span>
              <span>{row.name}</span>
              <span class="detail text-dark-text">{row.detail(years)}</span>
              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="text-mint"><path d="M5 12l5 5 9-10"></path></svg>
            </div>
          ))}
          <div class="frow rounded-lg border border-dashed border-mint bg-mint/8 px-3.5 py-2.5 text-white">
            <span class="text-amber">05</span>
            <span>Tu contacto</span>
            <span class="detail" aria-hidden="true"></span>
            <span class="text-mint">esperando…</span>
          </div>
        </div>
        <div class="mt-4 border-t border-dark-line pt-3.5">
          <div class="mb-2 flex justify-between text-[10px] text-dark-text"><span>PREPARACIÓN</span><span>4 / 5</span></div>
          <div class="h-1.5 overflow-hidden rounded-full bg-dark-line"><div class="h-full w-4/5 rounded-full bg-mint"></div></div>
          <div class="mt-3 flex items-baseline justify-between">
            <span class="text-[10px] text-dark-text">SOLO FALTA</span>
            <span class="font-sans text-lg font-semibold text-mint">tu mensaje →</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .frow {
    display: grid;
    grid-template-columns: 32px 120px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
  }
  @media (max-width: 767px) {
    .frow {
      grid-template-columns: 24px minmax(0, 1fr) auto;
      column-gap: 10px;
      row-gap: 2px;
    }
    .frow .detail {
      grid-column: 2;
      grid-row: 2;
      font-size: 11px;
    }
    .frow .detail:empty {
      display: none;
    }
  }
</style>
