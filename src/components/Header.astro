---
import { NAV, SITE } from '@data/site';
---

<header class="sticky top-0 z-20 border-b border-line bg-bg/95 backdrop-blur-md">
  <div class="wrap flex items-center justify-between gap-6 py-3.5">
    <a href="#inicio" class="whitespace-nowrap text-base font-semibold text-ink hover:text-ink">{SITE.shortName}</a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="m-0 flex list-none gap-1 p-0 text-sm">
        {NAV.map((item) => (
          <li><a href={item.href} class="block rounded-lg px-3 py-3 text-text hover:text-ink">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="#contacto" class="btn btn-primary px-4.5! py-2.5! text-sm whitespace-nowrap" data-umami-event="contacto-header">Conversemos</a>
      <button
        type="button"
        class="menu-toggle inline-flex size-11 items-center justify-center rounded-[10px] border border-line-strong bg-transparent text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
      >
        <svg class="icon-open" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        <svg class="icon-close hidden" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
  </div>

  <nav id="menu-movil" aria-label="Principal (móvil)" class="hidden border-t border-line lg:hidden" hidden>
    <ul class="wrap m-0 flex list-none flex-col py-2">
      {NAV.map((item) => (
        <li><a href={item.href} class="block border-b border-line py-3.5 text-base text-ink last:border-b-0 hover:text-accent">{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('menu-movil');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
      toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
      menu.hidden = !open;
      menu.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
