---
import { TOOLS } from '@data/site';
---

<section id="herramientas" aria-labelledby="herramientas-titulo" class="bg-teal-dark text-[#e6f0ef]">
  <div class="wrap section">
    <p class="eyebrow text-mint!">04 — Herramientas</p>
    <h2 id="herramientas-titulo" class="h2 text-white">Las herramientas, al servicio del proceso.</h2>
    <dl class="mt-12 mb-0 grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-px overflow-hidden rounded-[18px] border border-teal-line bg-teal-line">
      {TOOLS.map((tool) => (
        <div class="bg-teal-dark p-6">
          <dt class="mb-3 font-mono text-xs text-mint uppercase">{tool.group}</dt>
          <dd class="m-0 text-[15px] text-[#d3e4e2]">{tool.items}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
