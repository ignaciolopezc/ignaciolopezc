---
import { METHOD } from '@data/site';
---

<section id="metodo" aria-labelledby="metodo-titulo" class="border-y border-line bg-band">
  <div class="wrap section">
    <p class="eyebrow">04 — Cómo trabajo</p>
    <h2 id="metodo-titulo" class="h2">Un método en cuatro pasos.</h2>
    <ol class="mt-12 mb-0 grid list-none grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-6 p-0">
      {METHOD.map((item, i) => (
        <li class:list={['border-t-2 pt-5', i === METHOD.length - 1 ? 'border-accent-deep' : 'border-ink']}>
          <p class="mt-0 mb-2 font-mono text-[13px] text-accent-deep">{String(i + 1).padStart(2, '0')} / {item.step}</p>
          <p class="m-0 text-[15px] text-text">{item.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
