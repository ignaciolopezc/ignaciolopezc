---
import { FAQ } from '@data/site';
---

<section id="faq" class="wrap section flex flex-wrap gap-x-18 gap-y-10">
  <div class="flex-[1_1_340px]">
    <p class="eyebrow">07 — Preguntas frecuentes</p>
    <h2 class="h2">Lo que suelen preguntarme.</h2>
  </div>
  <div class="min-w-0 flex-[999_1_520px] border-b border-line">
    {FAQ.map((item, i) => (
      <details class="border-t border-line py-5" open={i === 0}>
        <summary class="flex cursor-pointer list-none justify-between gap-4 text-[17px] font-medium">
          {item.q}
          <span class="plus text-[22px] leading-none text-accent-deep transition-transform" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 mb-0 text-[15px] text-muted">{item.a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  details[open] .plus {
    transform: rotate(45deg);
  }
</style>
