---
import { Picture } from 'astro:assets';
import photo from '@assets/images/ignacio.jpg';
import { HERO_FLOW, KPIS } from '@data/site';

interface Props {
  years: number;
}

const { years } = Astro.props;
const kpis = [{ value: `+${years}`, label: 'años en consultoría' }, ...KPIS];
---

<section id="inicio" class="wrap grid items-center gap-16 lg:items-end pt-16 pb-24 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-18 lg:pt-22">
  <div class="min-w-0">
    <p class="eyebrow">Consultor en procesos, integración y automatización</p>
    <h1 class="h1">Automatizo procesos, no solo <span class="serif">tareas</span>.</h1>
    <p class="mt-7 mb-0 max-w-[540px] text-[19px] leading-relaxed text-text">
      Ordeno, conecto y estandarizo los procesos de tu equipo para que cada automatización entregue valor real y se mantenga en el tiempo.
    </p>
    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a href="#contacto" class="btn btn-primary">Conversemos sobre tu proceso</a>
      <a href="#metodo" class="btn btn-secondary">Ver cómo trabajo</a>
    </div>
    <dl class="mt-12 mb-0 flex flex-wrap gap-x-10 gap-y-6 border-t border-line pt-7">
      {kpis.map((kpi) => (
        <div class="flex flex-col-reverse">
          <dt class="text-sm text-muted">{kpi.label}</dt>
          <dd class="m-0 text-[30px] leading-[1.6] font-semibold tracking-[-0.02em]">{kpi.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <div class="mx-auto w-full max-w-[440px] lg:max-w-[360px]">
    <Picture
      src={photo}
      formats={['avif', 'webp']}
      widths={[440, 742]}
      sizes="(min-width: 1024px) 360px, (min-width: 488px) 440px, calc(100vw - 48px)"
      alt="Ignacio López Campos"
      loading="eager"
      fetchpriority="high"
      class="block aspect-[4/5] w-full rounded-3xl bg-band object-cover"
    />
    <div
      class="flow relative max-w-[340px] rounded-2xl bg-ink p-4 font-mono text-[11px] text-[#e6e8ea] shadow-[0_20px_50px_rgb(21_23_26/0.25)]"
      role="img"
      aria-label="Flujo de automatización en ejecución: captura, valida, registra y optimiza; de 6 horas manuales a 20 minutos"
    >
      <div class="mb-3 flex justify-between gap-3 text-dark-text"><span>automatizacion.flow</span><span class="text-mint">● en ejecución</span></div>
      <div class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)_auto_minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-1">
        {HERO_FLOW.map((step, i) => {
          const last = i === HERO_FLOW.length - 1;
          return (
            <Fragment>
              <div class:list={['rounded-lg px-1 py-[7px] text-center', last ? 'bg-accent-deep text-white' : 'border border-dark-line']}>
                <div class={last ? 'text-mint-soft' : 'text-mint'}>{String(i + 1).padStart(2, '0')}</div>{step}
              </div>
              {!last && <span class="text-[#7a8088]">→</span>}
            </Fragment>
          );
        })}
      </div>
      <div class="mt-3 flex items-baseline justify-between gap-3 border-t border-dark-line pt-2.5">
        <span class="text-[10px] text-dark-text">TIEMPO POR CICLO</span>
        <span class="font-sans text-base font-semibold text-white">6 h <span class="font-normal text-[#7a8088]">→</span> <span class="text-mint">20 min</span></span>
      </div>
    </div>
  </div>
</section>

<style>
  .flow {
    margin: -70px 0 0 -48px;
  }
  @media (max-width: 1023px) {
    .flow {
      margin: -80px 12px 0 12px;
    }
  }
</style>
