---
import Layout from '@layouts/layout.astro';
import Header from '@components/Header.astro';
import Hero from '@components/Hero.astro';
import Clients from '@components/Clients.astro';
import Approach from '@components/Approach.astro';
import Services from '@components/Services.astro';
import Career from '@components/Career.astro';
import Tools from '@components/Tools.astro';
import Faq from '@components/Faq.astro';
import NextStep from '@components/NextStep.astro';
import Contact from '@components/Contact.astro';
import { calculateYears } from '@utils/dateUtils';

const years = calculateYears();
---

<Layout>
  <Header />
  <main>
    <Hero years={years} />
    <Clients />
    <Approach />
    <Services />
    <Career />
    <Tools />
    <Faq />
    <NextStep years={years} />
    <Contact />
  </main>
</Layout>
