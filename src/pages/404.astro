---
import Layout from '@layouts/layout.astro';
import { SITE } from '@data/site';
---

<Layout title={`Página no encontrada | ${SITE.name}`} noindex>
  <main class="wrap flex min-h-screen flex-col items-start justify-center py-24">
    <p class="eyebrow">Error 404</p>
    <h1 class="h2">Esta página <span class="serif">no existe</span>.</h1>
    <p class="mt-5 mb-8 max-w-[480px] text-text">Puede que el enlace esté mal escrito o que la página se haya movido. Desde el inicio encuentras todo lo demás.</p>
    <div class="flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Volver al inicio</a>
      <a href="/#contacto" class="btn btn-secondary">Contactarme</a>
    </div>
  </main>
</Layout>
